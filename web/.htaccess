# Same cache policy as fl.unhackdemocracy.us: HTML always revalidates,
# the hashed CSS URL is cached forever since a new deploy gives it a new
# URL. See build.sh for the hash stamping.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <!-- Every script URL is hashed too (see build.sh), so the same rule
       applies: a change gives it a new URL, and the old one can be kept
       forever. Without this it fell back to the host's one-week default,
       which is the one window where a tester can be looking at yesterday
       and not know it. -->
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <!-- Not hashed, so a short bound rather than a long cache with no easy
       way to force it — same reasoning as unhack-fl's data/*.json rule. -->
  <FilesMatch "\.svg$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  <!-- The og:image. Social platforms cache it on their own side once
       scraped, so a long local max-age would only make a future swap
       harder to see while testing. -->
  <FilesMatch "\.(png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
